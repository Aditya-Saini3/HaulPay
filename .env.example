# HaulPay environment.
#
# Copy to `.env` and fill in. Every key is read at build time by Metro, which
# inlines EXPO_PUBLIC_* variables into the bundle, so changing one means
# restarting the dev server (`npm start -- --clear`).
#
# Nothing here is a secret. The Supabase anon key is designed to be public and
# is protected by Row Level Security; tile and routing keys should be restricted
# by bundle id or referrer at the provider. Never put a service-role key here.
#
# The app runs with none of this set: it falls back to the stub adapters and the
# local SQLite database, which is enough to click through every screen.

# ---------------------------------------------------------------------------
# Supabase — auth, Postgres and file storage
# ---------------------------------------------------------------------------
# Project settings → API. Run the migrations in supabase/migrations first.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
# Map tiles — OSM vector tiles, rendered by MapLibre GL Native
# ---------------------------------------------------------------------------
# Do NOT point these at tile.openstreetmap.org: its tile usage policy forbids
# app traffic of this kind. Use a hosted OSM vector tile provider, or self-host
# Protomaps from a single .pmtiles file for zero per-request cost.
#
#   MapTiler     https://api.maptiler.com/maps/streets-v2/style.json?key=KEY
#                https://api.maptiler.com/maps/streets-v2-dark/style.json?key=KEY
#   Stadia Maps  https://tiles.stadiamaps.com/styles/osm_bright.json
#                https://tiles.stadiamaps.com/styles/alidade_smooth_dark.json
#   Protomaps    https://your-host/styles/light.json  (self-hosted)
EXPO_PUBLIC_MAP_STYLE_URL_LIGHT=
EXPO_PUBLIC_MAP_STYLE_URL_DARK=
# Appended as ?key=, or substituted for a {key} placeholder in the style URL.
EXPO_PUBLIC_MAP_TILE_API_KEY=
# Shown next to "© OpenStreetMap contributors" in the map attribution.
EXPO_PUBLIC_MAP_PROVIDER_NAME=

# ---------------------------------------------------------------------------
# Geocoding — Photon for type-ahead, Nominatim for full-address lookups
# ---------------------------------------------------------------------------
# Photon is OSM-based and purpose-built for autocomplete. The public instance is
# fine for development; self-host or use a paid OSM geocoder (LocationIQ,
# Geocode Earth) for production volume by changing this one URL.
EXPO_PUBLIC_PHOTON_BASE_URL=https://photon.komoot.io

# Nominatim is the fallback for full addresses only, never for keystrokes. The
# public instance allows roughly one request per second and the app enforces
# that internally.
EXPO_PUBLIC_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# REQUIRED by Nominatim's usage policy: a descriptive User-Agent identifying the
# app and a way to contact you. A generic one gets your IP blocked.
EXPO_PUBLIC_GEOCODER_USER_AGENT=HaulPay/1.0 (+https://your-domain.example; ops@your-domain.example)
# Optional contact address, sent as ?email= on Nominatim requests.
EXPO_PUBLIC_NOMINATIM_EMAIL=

# ---------------------------------------------------------------------------
# Routing — Valhalla, using its truck costing model
# ---------------------------------------------------------------------------
# Hosted: Stadia Maps offers a Valhalla endpoint. Self-hosted: run the
# valhalla/valhalla container against a regional OSM extract from Geofabrik.
# Leave blank and the app falls back to a straight-line mileage estimate, which
# it labels as an estimate in the UI.
EXPO_PUBLIC_VALHALLA_BASE_URL=
EXPO_PUBLIC_VALHALLA_API_KEY=

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Forces the stub map, geocode and route adapters. Useful for demos, offline
# development and screenshots.
EXPO_PUBLIC_USE_STUB_ADAPTERS=false

# Receipt OCR pre-fill. Off by design so it can ship later.
EXPO_PUBLIC_ENABLE_RECEIPT_OCR=false
